# Database Configuration
# PostgreSQL connection string with connection pooling
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA&connection_limit=10&pool_timeout=10
# 
# Connection Pooling Parameters (recommended for production):
# - connection_limit: Max connections in pool (default: num_cpus * 2 + 1, recommended: 10-20)
# - pool_timeout: Seconds to wait for connection from pool (default: 10)
# - connect_timeout: Seconds to wait for new connection (default: 5)
# - socket_timeout: Seconds for socket operations (default: none)
#
# Example with pooling:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/posyandu_lansia?schema=public&connection_limit=10&pool_timeout=10"
DATABASE_URL="postgresql://postgres:password@localhost:5432/posyandu_lansia?schema=public&connection_limit=10&pool_timeout=10"

# JWT Configuration
# Secret key untuk signing JWT tokens (gunakan string random yang kuat)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Application Configuration
# Environment: development | production | test
NODE_ENV="development"

# Frontend URL untuk CORS configuration
APP_URL="http://localhost:3000"

# Server Port (untuk local development)
PORT="3001"

# Timezone
# Default timezone untuk aplikasi
TIMEZONE="Asia/Jakarta"

# Admin Seeder Configuration (Optional)
# Jika tidak diisi, password akan di-generate secara random
ADMIN_NAME="Admin Posyandu"
ADMIN_EMAIL="admin@posyandu.local"
ADMIN_PASS=""

# Logging Configuration
LOG_LEVEL="info"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="5"
