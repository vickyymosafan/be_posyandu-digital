# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/posyandu_lansia?schema=public"

# JWT Configuration
# Secret key untuk signing JWT tokens (gunakan string random yang kuat)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Application Configuration
# Environment: development | production | test
NODE_ENV="development"

# Frontend URL untuk CORS configuration
APP_URL="http://localhost:3000"

# Server Port (untuk local development)
PORT="3001"

# Timezone
# Default timezone untuk aplikasi
TIMEZONE="Asia/Jakarta"

# Admin Seeder Configuration (Optional)
# Jika tidak diisi, password akan di-generate secara random
ADMIN_NAME="Admin Posyandu"
ADMIN_EMAIL="admin@posyandu.local"
ADMIN_PASS=""

# Logging Configuration
LOG_LEVEL="info"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="5"
